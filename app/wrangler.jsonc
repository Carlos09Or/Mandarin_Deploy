{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mandarin-deploy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Static files are served straight from the assets; the Worker only runs for the API and the admin page.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mandarin-journey",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
